<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_employee_intro_letter_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.intro.letter.wizard.form</field>
        <field name="model">hr.employee.intro.letter.wizard</field>
        <field name="arch" type="xml">
            <form string="Giấy giới thiệu nhân sự">
                <group>
                    <field name="employee_id"/>
                    <field name="recipient" placeholder="Ban Quản lý bãi xe..."/>
                    <field name="education_level" placeholder="12/12"/>
                    <field name="work_shift" placeholder="15h-23h"/>
                    <field name="health_status"/>
                    <field name="export_format" widget="radio"/>
                </group>
                <footer>
                    <button name="action_download" type="object" string="Tải về" class="btn-primary" data-hotkey="q"/>
                    <button string="Hủy" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_intro_letter_wizard" model="ir.actions.act_window">
        <field name="name">Giấy giới thiệu nhân sự</field>
        <field name="res_model">hr.employee.intro.letter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
