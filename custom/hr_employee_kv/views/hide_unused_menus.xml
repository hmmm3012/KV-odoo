<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide the root Discuss and Calendar menus for every user.
         Employee chatter and the Time Off calendar stay available;
         they use other actions/views, not these application root menus. -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
