<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- FORM: Replace private address fields and modify labels -->
  <record id="view_employee_form_inherit_addresses" model="ir.ui.view">
    <field name="name">hr.employee.form.addresses.custom</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      
      <!-- Replace the private address div with custom address fields -->
      <xpath expr="//label[@for='private_street']" position="replace">
        <field name="emp_permanent_address"/>
      </xpath>
      
      <xpath expr="//div[@class='o_address_format']" position="replace">
        <field name="emp_temporary_address"/>
      </xpath>

      <!-- Change identification_id label to CCCD -->
      <xpath expr="//field[@name='identification_id']" position="attributes">
        <attribute name="string">CCCD</attribute>
      </xpath>

      <!-- Add identification_date and identification_by after identification_id -->
      <xpath expr="//field[@name='identification_id']" position="after">
        <field name="identification_date"/>
        <field name="identification_by"/>
      </xpath>

      <!-- Make country_id readonly and ensure it shows Vietnam -->
      <xpath expr="//field[@name='country_id']" position="attributes">
        <attribute name="readonly">1</attribute>
        <attribute name="help">Country is set to Vietnam and cannot be changed</attribute>
      </xpath>

      <!-- Hide distance_home_work field -->
      <xpath expr="//label[@for='distance_home_work']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//div[@name='div_km_home_work']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- Insert emp_code before the work_email field in the header area -->
      <xpath expr="//field[@name='work_email']" position="before">
        <field name="emp_code"/>
      </xpath>

      <!-- Insert Work Info group before the Location group (anchor by presence of address_id field) -->
      <xpath expr="//page[@name='public']//div[@id='o_work_employee_main']/group[./field[@name='address_id']]" position="before">
        <group>
          <field name="tax_identification_number" string="Mã số thuế"/>
          <field name="sinid" string="Mã bảo hiểm"/>
          <field name="date_import" string="Ngày nhận việc"/>
          <field name="departure_date" string="Ngày nghỉ việc"/>
          <field name="notes" string="Ghi chú"/>
        </group>
      </xpath>

      <!-- Hide Settings page -->
      <xpath expr="//page[@name='hr_settings']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- Hide coach_id and parent_id fields -->
      <xpath expr="//field[@name='coach_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='parent_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- Hide work_location_id field -->
      <xpath expr="//field[@name='work_location_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- Hide Work Permit separator and related fields -->
      <xpath expr="//separator[@name='has_work_permit']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='visa_no']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='permit_no']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='visa_expire']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='work_permit_expiration_date']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='work_permit_name']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='has_work_permit']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- Hide Family Status separator and related fields -->
      <xpath expr="//group[@name='emergency']/separator" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='marital']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='spouse_complete_name']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='spouse_birthdate']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      
      <xpath expr="//field[@name='children']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

    </field>
  </record>

  <!-- LIST: Set default visible fields in employee list view -->
  <record id="view_employee_list_inherit_addresses" model="ir.ui.view">
    <field name="name">hr.employee.list.addresses</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_tree"/>
    <field name="arch" type="xml">
      <!-- Support both <list> (v17+) and <tree> (older) -->
      <xpath expr="//list | //tree" position="inside">
        <!-- Default visible fields -->
        <field name="emp_code" string="Mã nhân viên" optional="show"/>
        <field name="notes" string="Ghi chú" optional="show"/>
        <field name="date_import" string="Ngày nhận việc" optional="show"/>
        <field name="departure_date" string="Ngày nghỉ việc" optional="show"/>
        
        <!-- Hidden fields by default -->
        <field name="emp_permanent_address" optional="hide"/>
        <field name="emp_temporary_address" optional="hide"/>
        <field name="sinid" string="Mã bảo hiểm" optional="hide"/>
        <field name="departure_description" string="Ghi chú quá trình" optional="hide"/>
        <field name="tax_identification_number" string="Mã số thuế" optional="hide"/>
      </xpath>
      
      <!-- Add mobile_phone field to the list -->
      <xpath expr="//field[@name='work_phone']" position="after">
        <field name="mobile_phone" string="Mobile Phone" optional="show"/>
      </xpath>
      
      <!-- Set default visibility for existing fields -->
      <xpath expr="//field[@name='name']" position="attributes">
        <attribute name="optional">show</attribute>
      </xpath>
      
      <xpath expr="//field[@name='work_phone']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='company_id']" position="attributes">
        <attribute name="optional">show</attribute>
      </xpath>
      
      <xpath expr="//field[@name='work_email']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='activity_ids']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='activity_user_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='activity_date_deadline']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='department_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='job_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='parent_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='work_location_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='coach_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='category_ids']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      
      <xpath expr="//field[@name='country_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
    </field>
  </record>

  <!-- SEARCH: Add filters for month_of_birth and date_import -->
  <record id="view_employee_search_inherit_filters" model="ir.ui.view">
    <field name="name">hr.employee.search.filters.custom</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_filter"/>
    <field name="arch" type="xml">
      <!-- Add month_of_birth field to search -->
      <field name="job_id" position="after">
        <field name="month_of_birth" string="Tháng sinh"/>
      </field>
      
      <!-- Add date_import field to search -->
      <field name="month_of_birth" position="after">
        <field name="date_import" string="Ngày nhận việc"/>
      </field>
      
      <!-- Add filter for month of birth -->
      <filter name="inactive" position="before">
        <filter name="filter_birth_month" string="Tháng sinh" domain="[]" context="{'group_by': 'month_of_birth'}"/>
      </filter>
      
      <!-- Add filter for date import -->
      <filter name="filter_birth_month" position="after">
        <filter name="filter_date_import" string="Ngày nhận việc" domain="[]" context="{'group_by': 'date_import'}"/>
      </filter>
    </field>
  </record>

</odoo>