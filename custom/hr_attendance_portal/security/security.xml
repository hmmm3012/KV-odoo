    <data noupdate="1">
        <record id="hr_attendance_location_company_rule" model="ir.rule">
            <field name="name">Attendance location: multi-company</field>
            <field name="model_id" ref="model_hr_attendance_location"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_attendance_device_company_rule" model="ir.rule">
