        <record id="hr_attendance_event_officer_rule" model="ir.rule">
            <field name="name">Attendance officer: events of managed employees</field>
            <field name="model_id" ref="model_hr_attendance_event"/>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
            <field name="domain_force">
                ['|',
                 ('employee_id', '=', False),
                 ('employee_id.attendance_manager_id', '=', user.id)]
            </field>
        </record>

        <record id="hr_attendance_event_manager_rule" model="ir.rule">
            <field name="name">Attendance manager: all events</field>
            <field name="model_id" ref="model_hr_attendance_event"/>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
