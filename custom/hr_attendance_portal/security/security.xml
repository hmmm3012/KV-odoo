        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_attendance_overtime_case_company_rule" model="ir.rule">
        <field name="name">Overtime case: multi-company</field>
        <field name="model_id" ref="model_hr_attendance_overtime_case"/>
