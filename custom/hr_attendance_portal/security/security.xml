<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_attendance_site_captain" model="res.groups">
        <field name="name">Department Captain</field>
        <field name="category_id" ref="base.module_category_human_resources_attendances"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read employees and attendance in Authorized Departments only. No create, edit, or delete.</field>
    </record>

    <record id="hr_attendance_site_captain_attendance_rule" model="ir.rule">
        <field name="name">Site captain: attendance in authorized departments</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="groups" eval="[(4, ref('group_hr_attendance_site_captain'))]"/>
        <field name="domain_force">user._hr_site_captain_attendance_domain()</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_attendance_site_captain_employee_rule" model="ir.rule">
        <field name="name">Site captain: employees in authorized departments</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_hr_attendance_site_captain'))]"/>
        <field name="domain_force">user._hr_site_captain_employee_domain()</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

