<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_cleanup_attendance_sessions" model="ir.cron">
        <field name="name">Attendance Portal: cleanup sessions</field>
        <field name="model_id" ref="model_hr_attendance_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_flag_missing_checkout" model="ir.cron">
        <field name="name">Attendance: flag missing checkout</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_missing_checkout()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cleanup_attendance_auth_attempts" model="ir.cron">
        <field name="name">Attendance Portal: cleanup auth attempts</field>
        <field name="model_id" ref="model_hr_attendance_auth_attempt"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
