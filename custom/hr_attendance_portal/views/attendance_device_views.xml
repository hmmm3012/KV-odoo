<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_device_list" model="ir.ui.view">
        <field name="name">hr.attendance.device.list</field>
        <field name="model">hr.attendance.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_identifier"/>
                <field name="location_id"/>
                <field name="last_seen_at"/>
                <field name="revoked_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_device_form" model="ir.ui.view">
        <field name="name">hr.attendance.device.form</field>
        <field name="model">hr.attendance.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object" string="Revoke" class="btn-danger" invisible="revoked_at"/>
                    <button name="action_reactivate" type="object" string="Reactivate" class="btn-primary" invisible="not revoked_at"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_identifier"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="last_seen_at"/>
                            <field name="revoked_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_device" model="ir.actions.act_window">
        <field name="name">Kiosk Devices</field>
        <field name="res_model">hr.attendance.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hr_attendance_device"
        name="Kiosk Devices"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_device"
        sequence="21"
        groups="base.group_no_one"/>

    <record id="menu_hr_attendance_device" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
</odoo>
