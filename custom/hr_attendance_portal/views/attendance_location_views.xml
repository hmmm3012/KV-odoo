<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_location_list" model="ir.ui.view">
        <field name="name">hr.attendance.location.list</field>
        <field name="model">hr.attendance.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fence_mode"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="allowed_radius_meters"/>
                <field name="max_gps_accuracy_meters"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_location_form" model="ir.ui.view">
        <field name="name">hr.attendance.location.form</field>
        <field name="model">hr.attendance.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Workplace name"/></h1>
                    </div>
                    <field name="google_maps_api_key" invisible="1"/>
                    <field name="vertex_editor" widget="attendance_fence_map" nolabel="1" invisible="zone_count &gt; 1"/>
                    <group>
                        <group>
                            <field name="fence_mode"/>
                            <field name="zone_count"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="allowed_radius_meters"/>
                            <field name="max_gps_accuracy_meters"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Polygon zones">
                            <p class="text-muted">
                                A workplace may have several polygon zones. Check-in is valid inside any zone.
                                Import CSV with the same name on multiple rows to load more than one zone.
                            </p>
                            <field name="zone_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="point_count"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                    <field name="vertex_ids">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="latitude"/>
                                            <field name="longitude"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Departments">
                            <field name="linked_department_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_attendance_location_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.attendance.location.import.wizard.form</field>
        <field name="model">hr.attendance.location.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import workplace fences">
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <p class="text-muted">
                    CSV columns: WKT, name, description.
                    WKT is POLYGON ((longitude latitude, ...)).
                    The name matches a department; its workplace fence is replaced.
                    Several rows with the same name become several polygon zones on that workplace.
                    description is used as the zone name. Each polygon needs at least 4 points.
                </p>
                <field name="result_log" invisible="not result_log" readonly="1" widget="text"/>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_location" model="ir.actions.act_window">
        <field name="name">Workplaces</field>
        <field name="res_model">hr.attendance.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_attendance_location_import" model="ir.actions.act_window">
        <field name="name">Import Workplace Fences</field>
        <field name="res_model">hr.attendance.location.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_hr_attendance_location"
        name="Workplaces"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_location"
        sequence="20"
        groups="base.group_system"/>

    <menuitem
        id="menu_hr_attendance_location_import"
        name="Import Workplace Fences"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_location_import"
        sequence="21"
        groups="base.group_system"/>

    <record id="menu_hr_attendance_location" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="menu_hr_attendance_location_import" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
</odoo>
