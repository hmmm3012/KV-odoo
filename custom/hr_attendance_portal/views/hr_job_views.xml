<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_staff_structure" model="ir.ui.view">
        <field name="name">hr.job.form.staff.structure</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="structure_role"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hr_job_list_staff_structure" model="ir.ui.view">
        <field name="name">hr.job.list.staff.structure</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="structure_role" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
