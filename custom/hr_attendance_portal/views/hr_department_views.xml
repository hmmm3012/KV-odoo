<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form_attendance_portal" model="ir.ui.view">
        <field name="name">hr.department.form.attendance.portal</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <separator string="Attendance parking site"/>
                <field name="attendance_location_id"/>
                <field name="attendance_latitude"/>
                <field name="attendance_longitude"/>
                <field name="attendance_radius_meters"/>
                <field name="attendance_max_gps_accuracy_meters"/>
            </xpath>
        </field>
    </record>

    <record id="view_department_tree_attendance_portal" model="ir.ui.view">
        <field name="name">hr.department.list.attendance.portal</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="attendance_latitude" optional="hide"/>
                <field name="attendance_longitude" optional="hide"/>
                <field name="attendance_radius_meters" optional="hide"/>
                <field name="attendance_is_geofenced" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
