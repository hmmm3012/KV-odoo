<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_timesheet_wizard_form" model="ir.ui.view">
        <field name="name">hr.attendance.timesheet.wizard.form</field>
        <field name="model">hr.attendance.timesheet.wizard</field>
        <field name="arch" type="xml">
            <form class="o_hr_attendance_timesheet_form" create="false" delete="false" duplicate="false">
                <header>
                    <button name="action_preview" type="object" string="Xem bảng công" class="btn-secondary"/>
                    <button name="action_export" type="object" string="Xuất bảng công" class="btn-primary"/>
                    <button name="action_reset_row_order" type="object" string="Đặt lại thứ tự A→Z" class="btn-link"
                            invisible="not preview_html"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <separator string="Timesheet"/>
                    <field name="preview_html" widget="kv_timesheet_preview" nolabel="1" colspan="2"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_timesheet" model="ir.actions.act_window">
        <field name="name">Timesheet</field>
        <field name="res_model">hr.attendance.timesheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_hr_attendance_timesheet"
        name="Timesheet"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_timesheet"
        sequence="7"
        groups="group_hr_attendance_site_captain,hr_attendance.group_hr_attendance_officer"/>
</odoo>
