<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="attendance_portal_page" name="Attendance Portal">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'vi_VN'}"/>
            <t t-set="title">Chấm công</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#0f172a"/>
                <link rel="stylesheet" href="/hr_attendance_portal/static/src/attendance_portal.css?v=20261019l"/>
                <script src="/hr_attendance_portal/static/src/attendance_portal.js?v=20261019l" defer="defer"></script>
            </t>
            <t t-set="body_classname">kv-attendance-body</t>
            <main class="kv-shell" id="kv-attendance-app">
                <header class="kv-header">
                    <p class="kv-kicker">Kien Viet</p>
                    <h1>Chấm công</h1>
                    <p class="kv-sub" id="kv-clock">--:--</p>
                </header>

                <section class="kv-card" data-panel="login">
                    <form id="kv-login-form" autocomplete="off">
                        <label for="employee_code">Mã nhân viên</label>
                        <input id="employee_code" name="employee_code" inputmode="text" autocomplete="username" required="required"/>
                        <label for="pin">Mã PIN</label>
                        <input id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="current-password" required="required"/>
                        <button type="submit" class="kv-btn kv-btn-primary" id="kv-login-btn">Đăng nhập</button>
                    </form>
                </section>

                <section class="kv-card kv-hidden" data-panel="status">
                    <p class="kv-employee" id="kv-employee-name"></p>
                    <p class="kv-state" id="kv-state-label"></p>
                    <p class="kv-meta" id="kv-last-punch"></p>
                    <p class="kv-location-hint" id="kv-location-hint">Nhấn chấm công để trình duyệt xin quyền vị trí.</p>
                    <div class="kv-camera-wrap">
                        <video id="kv-camera" autoplay="autoplay" playsinline="playsinline" webkit-playsinline="webkit-playsinline" muted="muted" x5-playsinline="true" x5-video-player-type="h5" x5-video-player-fullscreen="false"></video>
                        <canvas id="kv-camera-preview" class="kv-camera-preview"></canvas>
                    </div>
                    <canvas id="kv-camera-canvas" class="kv-hidden"></canvas>
                    <p class="kv-location-hint" id="kv-camera-hint">Nhìn thẳng vào camera. Ảnh sẽ được kiểm tra trước khi chấm công.</p>
                    <button type="button" class="kv-btn kv-btn-primary kv-btn-lg" id="kv-check-btn">Chấm công vào</button>
                    <button type="button" class="kv-btn kv-btn-ghost" id="kv-logout-btn">Đăng xuất</button>
                </section>

                <p class="kv-message" id="kv-message" hidden="hidden"></p>
            </main>
        </t>
    </template>
</odoo>
