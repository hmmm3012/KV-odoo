        <field name="domain_force">[('department_id', 'child_of', user._hr_site_captain_department_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_kpi_employee_company_rule" model="ir.rule">
        <field name="name">KPI employee line: multi-company</field>
        <field name="model_id" ref="model_hr_kpi_monthly_employee"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_kpi_daily_captain_rule" model="ir.rule">
        <field name="name">Site captain: KPI daily lines in authorized departments</field>
        <field name="model_id" ref="model_hr_kpi_daily_line"/>
        <field name="groups" eval="[(4, ref('hr_attendance_portal.group_hr_attendance_site_captain'))]"/>
        <field name="domain_force">[('department_id', 'child_of', user._hr_site_captain_department_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_kpi_daily_company_rule" model="ir.rule">
        <field name="name">KPI daily line: multi-company</field>
        <field name="model_id" ref="model_hr_kpi_daily_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>