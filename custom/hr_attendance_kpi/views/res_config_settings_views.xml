<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kpi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kpi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance_portal.res_config_settings_view_form_attendance_portal"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='attendance_portal_settings']" position="inside">
                <setting string="Ngày chốt nhập KPI" help="Đội trưởng nhập KPI đến hết ngày trước ngày này của tháng sau.">
                    <field name="kpi_lock_day"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>